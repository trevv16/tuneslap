# Development Dockerfile with Air for hot reloading
FROM golang:1.24-bookworm

# Install build dependencies (required for bimg/libvips) and ffmpeg for audio processing
RUN apt-get update && apt-get install -y --no-install-recommends \
    libvips-dev \
    gcc \
    pkg-config \
    curl \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Install Air for hot reloading (pinned to version compatible with Go 1.24)
RUN go install github.com/cosmtrek/air@v1.51.0

# Add Go bin to PATH so air command is available
ENV PATH="${PATH}:/root/go/bin"

WORKDIR /app

# Copy go mod and sum files (context is now project root)
COPY server/go.mod server/go.sum ./

# Download all dependencies
RUN go mod download

# Copy Air configuration
COPY server/.air.toml ./

# Set environment variables
ENV GO_ENV=local
ENV PORT=8082

# Expose the port
EXPOSE 8082

# Run Air for hot reloading
CMD ["air"]
